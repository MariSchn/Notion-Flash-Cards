# Notion internal integration secret.
# https://www.notion.so/my-integrations -> New integration -> copy "Internal Integration Secret"
# Then open your flashcard page in Notion: ••• -> Connections -> add the integration.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret keys (NOT publishable).
# The legacy service_role JWT works too, via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
